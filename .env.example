R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_BUCKET=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_URL=https://your_account_id.r2.cloudflarestorage.com/your_bucket_name

# MongoDB — must run with --auth enabled and bound to 127.0.0.1 only
MONGO_URI=mongodb://username:password@127.0.0.1:27017/kando_db?authSource=admin

PORT=5000

# Basic Auth credentials required to reach /api/admin/* and /admin-login (enforced at nginx + app layer)
ADMIN_PANEL_USER=change_me
ADMIN_PANEL_PASS=change_me

# Restrict CORS to your real site origin
ALLOWED_ORIGIN=https://your-domain.example

# Cloudflare Worker that builds the CSV+media export zip directly from R2
# (edge-side), so large exports don't route media through this server.
# See cf-worker/ for the Worker source. Secret must match the Worker's
# EXPORT_SECRET binding.
EXPORT_WORKER_URL=https://kando-export.your-subdomain.workers.dev
EXPORT_WORKER_SECRET=change_me
